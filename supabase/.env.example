# Only for Edge Functions server secrets. Never put this file in a Pages artifact.
ORBITA_OWNER_ID=REPLACE_WITH_AUTH_USER_UUID
ORBITA_ALLOWED_ORIGIN=https://YOUR_GITHUB_USER.github.io
ORBITA_APP_URL=https://YOUR_GITHUB_USER.github.io/YOUR_REPOSITORY/
ORBITA_CREDENTIALS_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES

# Usually supplied by Supabase runtime: SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS,
# SUPABASE_SECRET_KEYS; legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY.
# If the new named maps are unavailable, these optional ORBITA_ overrides can
# provide the public and server-only secret keys without using reserved names.
# ORBITA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# ORBITA_SUPABASE_SECRET_KEY=sb_secret_...
