# Server-only encryption key for credentials saved from the Integrations panel.
# Use a stable, random 32-byte key encoded as Base64. Never use NEXT_PUBLIC_.
# Configure as a secret on the host. Keep the same key while encrypted records exist.
ORBITA_CREDENTIALS_KEY=''

# Public build configuration for the GitHub Pages frontend, safe to publish.
# Use the publishable key, NEVER a secret/service_role key in VITE_.
VITE_SUPABASE_URL=''
VITE_SUPABASE_PUBLISHABLE_KEY=''
VITE_BASE_PATH='/orbita-workspace/'

# Local administrator helper only: npm run auth:create-owner.
# These are never consumed by the browser. Leave empty in Git.
SUPABASE_URL=''
SUPABASE_SECRET_KEY=''

# Integrations are configured and encrypted through the panel, scoped to the
# signed-in user. Provider tokens do not belong in this file or in Git.
